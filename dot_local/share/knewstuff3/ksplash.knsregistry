  <previewBig>https://images.pling.com/img/00/00/84/99/24/2353004/video12.gif</previewBig>
  <payload>https://files06.pling.com/api/files/download/j/eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..9DT3Tb3QA9SsJdD5wDqWBTuHJsEPzWzmZu-d7ZgO8Y4/v1.5.tar.gz</payload>
